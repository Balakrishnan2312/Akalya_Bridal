# ===================================================
# Akalya Bridal Studio - Environment Configuration
# ===================================================

# Server Port (Render sets this dynamically)
PORT=5000

# Node Environment (use production on the deployed server)
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/akalya_bridal?retryWrites=true&w=majority

# JWT Authentication Secret Key (Required)
# Use a strong, random string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Admin Login Credentials (required on the first database-backed start)
ADMIN_NAME=Akalya Admin
ADMIN_EMAIL=admin@akalyasbridal.com
ADMIN_PASSWORD=replace_with_a_unique_password_of_8_or_more_characters

# Allowed frontend origin(s). Use CLIENT_URLS for a comma-separated list.
CLIENT_URL=http://localhost:5000

# Optional: seed remote sample gallery images on an empty database.
SEED_SAMPLE_CONTENT=false
